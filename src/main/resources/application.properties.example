spring.application.name=auto-repair-shop-api

spring.datasource.url=jdbc:mysql://localhost:3306/auto_repair_shop
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

spring.flyway.enabled=true

# Generate with: openssl rand -base64 32
jwt.secret=your_base64_encoded_secret_key_here_min_32_bytes
jwt.expiration=86400000

spring.mail.host=sandbox.smtp.mailtrap.io
spring.mail.port=2525
spring.mail.username=your_mailtrap_username
spring.mail.password=your_mailtrap_password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.cors.allowed-origins=http://localhost:5173

springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true

# Chatbot (Cloudflare Workers AI). Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN as environment variables.
app.chat.cloudflare.account-id=${CLOUDFLARE_ACCOUNT_ID:}
app.chat.cloudflare.api-token=${CLOUDFLARE_API_TOKEN:}
app.chat.cloudflare.model=@cf/meta/llama-3.3-70b-instruct-fp8-fast
app.chat.currency=EUR
app.chat.connect-timeout=5s
app.chat.read-timeout=20s
app.chat.max-tokens=400
app.chat.temperature=0.2
app.chat.rate-limit.max-requests=10
app.chat.rate-limit.window=60s
app.chat.daily-limit=300
